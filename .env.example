# ── LOCAL ──────────────────────────────────────────────────────
# Path relativo desde prisma/schema.prisma → sube un nivel → db/
DATABASE_URL=file:../db/custom.db

# ── RAILWAY (producción) ───────────────────────────────────────
# Montá un Volume en Railway en la ruta /data y usá esta URL:
# DATABASE_URL=file:/data/db.sqlite

# Secret para firmar los tokens JWT — generá uno con: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret
